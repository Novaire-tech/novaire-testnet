{
  "name": "web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=../../prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "vendor:freighter": "bash e2e/vendor/download-freighter.sh",
    "pretest:e2e:real": "npm run vendor:freighter",
    "test:e2e:real": "playwright test --project=real-wallet",
    "pretest:e2e:portfolio": "npm run vendor:freighter",
    "test:e2e:portfolio": "playwright test --project=portfolio-e2e"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.16.0",
    "next": "16.2.9",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "stellar-hd-wallet": "^1.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
