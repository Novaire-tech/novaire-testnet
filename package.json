{
  "name": "novaire",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "dev:docs": "npm run dev -w docs",
    "build:docs": "npm run build -w docs",
    "deploy": "tsx --env-file=.env scripts/deploy.ts",
    "deploy:epoch": "tsx --env-file=.env scripts/deploy.ts",
    "bootstrap": "tsx --env-file=.env scripts/bootstrap_liquidity.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
